<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Todo & Time Tracker</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 40px 16px;
      font-family: system-ui, sans-serif;
      background: #f3f4f6;
      color: #172033;
    }

    main {
      max-width: 640px;
      margin: auto;
      padding: 28px;
      background: white;
      border-radius: 16px;
      box-shadow: 0 8px 30px #17203312;
    }

    h1 { margin-top: 0; }

    form {
      display: flex;
      gap: 8px;
      margin-bottom: 24px;
    }

    input {
      flex: 1;
      min-width: 0;
      padding: 12px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font: inherit;
    }

    button {
      padding: 9px 12px;
      border: 0;
      border-radius: 8px;
      font: inherit;
      cursor: pointer;
    }

    form button, .start { background: #2563eb; color: white; }
    .pause { background: #fef3c7; color: #92400e; }
    .complete { background: #dcfce7; color: #166534; }
    .delete { background: #fee2e2; color: #991b1b; }

    .todo {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 0;
      border-top: 1px solid #e5e7eb;
    }

    .todo-info { min-width: 0; }
    .todo-title { overflow-wrap: anywhere; }
    .todo.done .todo-title {
      color: #6b7280;
      text-decoration: line-through;
    }

    .timer {
      margin-top: 4px;
      color: #6b7280;
      font-size: 14px;
      font-variant-numeric: tabular-nums;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 6px;
    }

    .empty { color: #6b7280; }

    @media (max-width: 520px) {
      .todo { align-items: flex-start; flex-direction: column; }
      .actions { justify-content: flex-start; }
    }
  </style>
</head>
<body>
  <main>
    <h1>Todo List</h1>
    <form id="todo-form">
      <input id="todo-input" type="text" placeholder="Hôm nay bạn cần làm gì?" required />
      <button type="submit">Thêm</button>
    </form>
    <section id="todo-list" aria-live="polite"></section>
  </main>

  <script>
    const STORAGE_KEY = "todo-time-tracker-v1";
    const form = document.querySelector("#todo-form");
    const input = document.querySelector("#todo-input");
    const list = document.querySelector("#todo-list");

    let todos = loadTodos();

    function loadTodos() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
      } catch {
        return [];
      }
    }

    function saveTodos() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
    }

    function escapeHTML(value) {
      return String(value).replace(/[&<>"']/g, char => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;",
        '"': "&quot;", "'": "&#039;"
      })[char]);
    }

    function elapsedMs(todo) {
      return todo.elapsedMs + (todo.startedAt ? Date.now() - todo.startedAt : 0);
    }

    function formatTime(ms) {
      const totalSeconds = Math.floor(ms / 1000);
      const hours = String(Math.floor(totalSeconds / 3600)).padStart(2, "0");
      const minutes = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, "0");
      const seconds = String(totalSeconds % 60).padStart(2, "0");
      return `${hours}:${minutes}:${seconds}`;
    }

    function render() {
      if (todos.length === 0) {
        list.innerHTML = '<p class="empty">Chưa có việc nào. Thêm việc đầu tiên nhé!</p>';
        return;
      }

      list.innerHTML = todos.map(todo => `
        <article class="todo ${todo.done ? "done" : ""}">
          <div class="todo-info">
            <div class="todo-title">${escapeHTML(todo.title)}</div>
            <div class="timer" data-time-id="${todo.id}">
              ${formatTime(elapsedMs(todo))}
              ${todo.startedAt ? " · Đang chạy" : ""}
            </div>
          </div>
          <div class="actions">
            ${!todo.done ? `
              <button class="${todo.startedAt ? "pause" : "start"}"
                data-action="${todo.startedAt ? "pause" : "start"}"
                data-id="${todo.id}">
                ${todo.startedAt ? "Tạm dừng" : "Bắt đầu"}
              </button>
              <button class="complete" data-action="complete" data-id="${todo.id}">
                Hoàn thành
              </button>
            ` : ""}
            <button class="delete" data-action="delete" data-id="${todo.id}">
              Xóa
            </button>
          </div>
        </article>
      `).join("");
    }

    form.addEventListener("submit", event => {
      event.preventDefault();
      const title = input.value.trim();
      if (!title) return;

      todos.push({
        id: `${Date.now()}-${Math.random().toString(16).slice(2)}`,
        title,
        elapsedMs: 0,
        startedAt: null,
        done: false
      });

      input.value = "";
      saveTodos();
      render();
    });

    list.addEventListener("click", event => {
      const button = event.target.closest("button[data-action]");
      if (!button) return;

      const todo = todos.find(item => item.id === button.dataset.id);
      if (!todo) return;

      switch (button.dataset.action) {
        case "start":
          // Chỉ chạy một đồng hồ tại một thời điểm.
          todos.forEach(item => {
            if (item.startedAt) {
              item.elapsedMs += Date.now() - item.startedAt;
              item.startedAt = null;
            }
          });
          todo.startedAt = Date.now();
          break;

        case "pause":
          todo.elapsedMs += Date.now() - todo.startedAt;
          todo.startedAt = null;
          break;

        case "complete":
          if (todo.startedAt) {
            todo.elapsedMs += Date.now() - todo.startedAt;
            todo.startedAt = null;
          }
          todo.done = true;
          break;

        case "delete":
          todos = todos.filter(item => item.id !== todo.id);
          break;
      }

      saveTodos();
      render();
    });

    // Cập nhật phần hiển thị đồng hồ mà không dựng lại toàn bộ danh sách.
    setInterval(() => {
      todos.forEach(todo => {
        if (!todo.startedAt) return;
        const timer = document.querySelector(`[data-time-id="${todo.id}"]`);
        if (timer) timer.textContent = `${formatTime(elapsedMs(todo))} · Đang chạy`;
      });
    }, 1000);

    render();
  </script>
</body>
</html>
